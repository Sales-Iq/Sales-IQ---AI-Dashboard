{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(html|htm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "tailwind.config.js",
      "*.docx",
      "*.pptx",
      "*.pdf",
      "*.py",
      "__pycache__/**",
      "extracted_images/**",
      "ChartsForPpt/**",
      "CONTEXT.md",
      "FEATURES.txt",
      "firestore-rules.txt"
    ]
  }
}
